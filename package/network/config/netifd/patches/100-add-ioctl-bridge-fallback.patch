 }
 
+/* Fallback to ioctl for old kernels where netlink bridge creation fails */
+static int system_bridge_addbr_ioctl(const char *name)
+{
+	int sock_fd;
+	int ret;
+
+	sock_fd = socket(AF_INET, SOCK_STREAM, 0);
+	if (sock_fd < 0)
+		return -1;
+
+	ret = ioctl(sock_fd, SIOCBRADDBR, name);
+	close(sock_fd);
+	
+	if (ret < 0)
+		return -errno;
+	
+	return 0;
+}
+
+static int system_bridge_set_params_ioctl(const char *name, struct bridge_config *cfg)
+{
+	int sock_fd;
+	struct ifreq ifr;
+	unsigned long args[4];
+
+	sock_fd = socket(AF_INET, SOCK_STREAM, 0);
+	if (sock_fd < 0)
+		return -1;
+
+	memset(&ifr, 0, sizeof(ifr));
+	strncpy(ifr.ifr_name, name, IFNAMSIZ - 1);
+	ifr.ifr_data = (char *)args;
+
+	/* Set STP state */
+	args[0] = BRCTL_SET_BRIDGE_STP_STATE;
+	args[1] = cfg->stp;
+	args[2] = 0;
+	args[3] = 0;
+	ioctl(sock_fd, SIOCDEVPRIVATE, &ifr);
+
+	/* Set forward delay */
+	args[0] = BRCTL_SET_BRIDGE_FORWARD_DELAY;
+	args[1] = sec_to_jiffies(cfg->forward_delay);
+	ioctl(sock_fd, SIOCDEVPRIVATE, &ifr);
+
+	/* Set hello time */
+	args[0] = BRCTL_SET_BRIDGE_HELLO_TIME;
+	args[1] = sec_to_jiffies(cfg->hello_time);
+	ioctl(sock_fd, SIOCDEVPRIVATE, &ifr);
+
+	/* Set max age */
+	args[0] = BRCTL_SET_BRIDGE_MAX_AGE;
+	args[1] = sec_to_jiffies(cfg->max_age);
+	ioctl(sock_fd, SIOCDEVPRIVATE, &ifr);
+
+	/* Set ageing time */
+	if (cfg->flags & BRIDGE_OPT_AGEING_TIME) {
+		args[0] = BRCTL_SET_AGEING_TIME;
+		args[1] = sec_to_jiffies(cfg->ageing_time);
+		ioctl(sock_fd, SIOCDEVPRIVATE, &ifr);
+	}
+
+	close(sock_fd);
+	return 0;
+}
+
 int system_bridge_addbr(struct device *bridge, struct bridge_config *cfg)
 {
