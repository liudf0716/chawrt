+#define BRCTL_SET_BRIDGE_STP_STATE 1
+#endif
+#ifndef BRCTL_SET_BRIDGE_FORWARD_DELAY
+#define BRCTL_SET_BRIDGE_FORWARD_DELAY 3
+#endif
+#ifndef BRCTL_SET_BRIDGE_HELLO_TIME
+#define BRCTL_SET_BRIDGE_HELLO_TIME 4
+#endif
+#ifndef BRCTL_SET_BRIDGE_MAX_AGE
+#define BRCTL_SET_BRIDGE_MAX_AGE 5
+#endif
